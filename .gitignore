*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ---- Models and run outputs ----
checkpoints/
models/
runs/
outputs/
# result folders written by run_test.py (they list test image names)
results/
# local audit archive (contains machine-specific paths; kept on this computer only)
archive/
wandb/
mlruns/
lightning_logs/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.pkl
*.joblib
# per-epoch training histories written by src/train.py (reports/<run_name>_history.csv)
reports/*_history.csv
# generated analysis outputs (plots, tables, text) written by scripts/analyze_baseline.py
reports/analysis/

# ---- Python, notebooks, caches ----
